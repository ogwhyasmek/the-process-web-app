{
  "name": "the-process",
  "compatibility_date": "2026-07-10",
  "main": "worker/index.js",
  "assets": {
    "directory": "./client/dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // /api must reach the Worker, never the SPA index.html fallback.
    "run_worker_first": ["/api/*"]
  }
}

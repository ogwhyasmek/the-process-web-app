# Copy this file to server/.env and fill in your key. server/.env is
# git-ignored — never commit it.

# Market data: get a free key at https://finnhub.io (60 requests/min tier
# is enough; the proxy throttles itself to ~1 request/second).
FINNHUB_API_KEY=

# Port the proxy listens on (the app's dev server forwards /api here).
PORT=4600

# Interface to listen on. The default, 127.0.0.1, means only this computer
# can reach the proxy — nobody else on your wifi can read your backups or
# spend your API quota. Set HOST=0.0.0.0 ONLY when deploying the proxy to
# a hosted platform (Render, Fly, Railway) that routes traffic in from outside.
HOST=127.0.0.1

# Only needed when the frontend is hosted on a different origin than this
# proxy. Comma-separated, e.g. https://the-process.pages.dev
ALLOWED_ORIGINS=
